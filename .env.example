# ============================================================
# SBK — environment variables template
# Copy this file to .env and fill in ONLY the lines of the sources you connect:
#   cp .env.example .env
# Values stay empty here. Never commit .env (it is in .gitignore).
# How to obtain each value: docs/CONNECTING.md
# Some scripts do not load .env by themselves; export it first:
#   set -a && source .env && set +a
# Lines written "# NAME=" are optional overrides with a built-in default:
# remove the "# " only if you set a value.
# ============================================================

# --- Data location ---
# Optional: where all downloaded and processed data lives (default ~/.sbk-data).
# SBK_DATA_ROOT=

# --- Google: your own OAuth client (email, calendar, gdrive, gsc, analytics) ---
# One personal "Desktop app" OAuth client from your Google Cloud project; each account signs in
# once in the browser and its refresh token goes to the Keychain.
# Path to the client JSON downloaded from the Google Cloud console.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=~/.secrets/google-oauth/client_secret.json
# Client ID of that OAuth client, used to refresh the stored tokens.
GOOGLE_OAUTH_CLIENT_ID=
# Client secret of that OAuth client.
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Slack (your own Slack app) ---
# User OAuth Token (xoxp-...) of your app. The one Slack credential SBK needs: channel index,
# download, monitor and health check all read with it. The Keychain (sbk-slack / user-token) is read first.
SLACK_USER_TOKEN=
# Optional, only for notifications (alerts, dashboard send box, tools/notify/slack_notify.py):
# the Bot User OAuth Token (xoxb-...) of the same app, so messages come from the app instead of from you.
# Without it they are sent with your user token, which then needs the chat:write user scope.
# SLACK_BOT_TOKEN=
# Optional: app-level token (xapp-...), read only by the real-time listener sl-realtime.py.
SLACK_APP_LEVEL_TOKEN=
# Optional: the DM channel id (D...) where the monitor's alerts land, so it does not alert on them again.
# SBK_SELF_ALERT_CHANNEL=

# --- Notion ---
# Internal integration secret; share the pages you want with the integration.
NOTION_TOKEN=

# --- Tactiq ---
# Firebase web API key of the Tactiq web app, used by tq-l0-download.py --direct.
TACTIQ_FIREBASE_API_KEY=

# --- Attio CRM ---
# API token with read scopes for the primary workspace.
ATTIO_API_KEY=
# Optional: 1 turns on the lane for Attio contacts without an email (off by default).
# SBK_ATTIO_CONTACTS_WITHOUT_EMAIL=

# --- DocuSign (JWT grant) ---
# Integration key of your app (Apps and Keys page).
DOCUSIGN_INTEGRATION_KEY=
# API user ID of the user the app acts as.
DOCUSIGN_USER_ID=
# API account ID to read (optional if the user has a single account).
DOCUSIGN_ACCOUNT_ID=
# Path to the RSA private key of the app (permissions 600).
# Empty = <data root>/secrets/docusign-private.key (follows SBK_DATA_ROOT).
DOCUSIGN_PRIVATE_KEY_PATH=
# Optional: auth host, default account.docusign.com (production).
# DOCUSIGN_AUTH_HOST=
# Optional: redirect URI registered on the app, default http://localhost:8765/docusign/callback
# DOCUSIGN_REDIRECT_URI=

# --- ClickUp ---
# Personal API token.
CLICKUP_API_KEY=
# Optional: back up a single workspace id (the list goes in clickup.teams in sbk.config.json).
# SBK_CLICKUP_TEAM=

# --- Plaud ---
# Optional: API host of your Plaud region (usually plaud.api_base in sbk.config.json).
# SBK_PLAUD_API_BASE=

# --- Voice Memos ---
# Optional: transcription language, "auto" or a code like "en" (usually voice_memos.language).
# SBK_VOICE_MEMOS_LANGUAGE=

# --- Personio ---
# API client ID with read access.
PERSONIO_CLIENT_ID=
# API client secret.
PERSONIO_CLIENT_SECRET=

# --- Whoop ---
# Client ID of your WHOOP developer app.
WHOOP_CLIENT_ID=
# Client secret of your WHOOP developer app.
WHOOP_CLIENT_SECRET=

# --- Microsoft 365 / Outlook (tools/microsoft365/) ---
# Application (client) ID of YOUR app registration (public client, redirect http://localhost).
# Not a secret, there is no client secret. Can also go in sbk.config.json microsoft365.client_id.
# Read by tools/microsoft365/ms_graph.py, used by ms-l0-auth.py and ms-l0-download.py: these
# scripts do not load .env by themselves, so export it first (set -a && source .env && set +a)
# or use the sbk.config.json key, which they always read.
SBK_MS365_CLIENT_ID=
# Optional: common (default), consumers, organizations, or your tenant id.
# SBK_MS365_TENANT=
# Only without a Keychain: path of a JSON file (created with mode 600) where ms-l0-auth.py stores
# the sign-in and every download keeps the newest refresh token. On macOS the Keychain entry
# sbk-microsoft365/<label> is used instead.
# SBK_MS365_TOKEN_FILE=
# Only without a Keychain and without the file above: a one-time seed refresh token per label,
# e.g. SBK_MS365_TOKEN_OUTLOOK. Read, never rewritten. In container mode (SBK_CONTAINERIZED=1)
# this seed is read BEFORE the file (it stands in for the Keychain): unset it after the first run.
# SBK_MS365_TOKEN_<LABEL>=

# --- IMAP / CalDAV / ICS (tools/imap-caldav/) ---
# Normally empty: store the secrets in the Keychain with
#   uv run python tools/imap-caldav/ic-l0-auth.py --account <label> --imap --caldav   (or --ics / --xoauth2)
# The code looks in the Keychain first, then here; <LABEL> = the account label in upper case.
# Mailbox app-specific password.
# SBK_MAILBOX_PASSWORD_<LABEL>=
# CalDAV app password (often the same app password).
# SBK_CALDAV_PASSWORD_<LABEL>=
# Calendar link: a secret, anyone with it reads the calendar.
# SBK_ICS_URL_<LABEL>=
# Outlook.com only: refresh token written by ic-l0-auth.py --xoauth2.
# SBK_IMAP_OAUTH_REFRESH_<LABEL>=

# --- Zoom (tools/zoom/) ---
# Public client ID of YOUR user-managed Zoom app ("Use Public Client OAuth" on). No secret.
# Read by tools/zoom/zm_api.py, used by zm-l0-auth.py and zm-l0-download.py: env first, then
# sbk.config.json zoom.client_id, then the Keychain entry sbk-zoom/client-id. These scripts do
# not load .env by themselves: export it first, or use the sbk.config.json key.
ZOOM_CLIENT_ID=
# Only without a Keychain: a file (created with mode 600) where the plugin keeps the newest
# refresh token, written by zm-l0-auth.py. On macOS the Keychain entry sbk-zoom/default is used.
# ZOOM_TOKEN_FILE=
# Only without a Keychain and without the file above: a one-time seed refresh token. In container
# mode (SBK_CONTAINERIZED=1) this seed is read BEFORE the file (it stands in for the Keychain), and
# Zoom replaces the refresh token at every refresh: unset it after the first run.
# ZOOM_REFRESH_TOKEN=

# --- GitHub (tools/github/) ---
# Your own personal access token, read only if the Keychain entry sbk-github/token is missing.
# Fine-grained (github_pat_...): Metadata, Issues, Pull requests and (for folders/README) Contents,
# all Read-only; it reaches one owner. Classic (ghp_...): repo + read:org.
GITHUB_TOKEN=
# Also accepted, same meaning.
# GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Databases (tools/databases/) ---
# One connection string per connection in sbk.config.json databases.connections, read only when
# the Keychain entry sbk-databases/<connection name> is missing. NAME = the connection name in
# upper case, every character that is not a letter or digit turned into _ (my-crm -> MY_CRM).
#   PostgreSQL: postgresql://reader:password@db.example:5432/crm   (or key=value)
#   MySQL:      mysql://reader:password@db.example:3306/crm        (percent-encode special characters)
# SBK_DB_URL_<NAME>=

# --- HubSpot (tools/hubspot/, docs/CONNECTING.md#hubspot) ---
# Client ID and client secret of YOUR user-level app (Auth tab of the app in HubSpot).
# The Keychain is read first (sbk-hubspot/client-id, sbk-hubspot/client-secret); these are the fallback.
# hs-l0-auth.py and hs-l0-download.py do not load .env by themselves: export it first
# (set -a && source .env && set +a), or put the client ID in sbk.config.json hubspot.client_id.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Only without a Keychain (containers, Linux without a keyring): a file (mode 600) where the plugin
# keeps the refresh token written by hs-l0-auth.py. Read before HUBSPOT_REFRESH_TOKEN.
# On macOS the Keychain entry sbk-hubspot/default is used instead.
# HUBSPOT_TOKEN_FILE=
# Only without a Keychain: a refresh token you already have (one-time seed).
# HUBSPOT_REFRESH_TOKEN=

# --- Pipedrive (tools/pipedrive/, docs/CONNECTING.md#pipedrive) ---
# Your personal API token: Pipedrive, Settings, Personal preferences, API
# (https://app.pipedrive.com/settings/api). One per company you belong to; read only if the
# Keychain entry sbk-pipedrive/api-token is missing.
PIPEDRIVE_API_TOKEN=
# Only for the OAuth route (a private app you registered yourself, read-only scopes), instead of
# the API token. The client ID may also go in sbk.config.json (pipedrive.client_id).
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
# pd-l0-auth.py writes the refresh token in the Keychain (sbk-pipedrive/refresh-token). Without a
# Keychain, point this to a file the sign-in may write (mode 600), or set the refresh token itself:
# PIPEDRIVE_TOKEN_FILE=
# PIPEDRIVE_REFRESH_TOKEN=

# --- Fireflies (tools/fireflies/, docs/CONNECTING.md#fireflies) ---
# Your personal API key: app.fireflies.ai -> Integrations -> Fireflies API. Read after the
# Keychain entry sbk-fireflies/api-key; ff-l0-download.py loads this file by itself.
FIREFLIES_API_KEY=

# --- Fathom (tools/fathom/, docs/CONNECTING.md#fathom) ---
# Your personal Fathom API key (Fathom: User Settings -> API Access). Read only when the
# Keychain entry sbk-fathom/api-key is not set. Sees only meetings you recorded or that were
# shared with you or your team.
FATHOM_API_KEY=
# Same key under the name Fathom's own SDKs read; used only if FATHOM_API_KEY is empty.
# FATHOM_API_KEY_AUTH=

# --- Granola (tools/granola/, docs/CONNECTING.md#granola) ---
# Your PERSONAL Granola API key (starts with grn_), Business plan: Granola desktop app ->
# Settings -> Connectors -> API keys -> Create new key, scope "Personal notes".
# Read after the Keychain entry sbk-granola/api-key. The free plan has no API key: use the
# CSV export with tools/granola/gr-l0-import-csv.py instead. gr-l0-download.py does not load .env by
# itself: export it first (set -a && source .env && set +a), or use the Keychain entry.
GRANOLA_API_KEY=

# --- Microsoft Teams (tools/teams/, docs/CONNECTING.md#teams) ---
# No variable of its own: Teams uses the Microsoft 365 section's SBK_MS365_CLIENT_ID,
# SBK_MS365_TENANT (organizations or your tenant id: personal accounts cannot read Teams chats),
# SBK_MS365_TOKEN_FILE and SBK_MS365_TOKEN_<LABEL>. Sign in with tools/teams/tm-l0-auth.py, which
# adds Chat.Read to the shared sign-in sbk-microsoft365/<label>.

# --- Atlassian: Jira and Confluence Cloud (tools/atlassian/, docs/CONNECTING.md#atlassian) ---
# Your site and the email of your Atlassian account. They may also go in sbk.config.json
# (atlassian.site, atlassian.email), which wins over these.
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
# Your API token, created at https://id.atlassian.com/manage-profile/security/api-tokens.
# A token without scopes covers Jira and Confluence. Read only if the Keychain entry
# sbk-atlassian/api-token is missing.
ATLASSIAN_API_TOKEN=
# Only with tokens WITH scopes, one per product (each overrides the shared token for its product):
# ATLASSIAN_JIRA_API_TOKEN=
# ATLASSIAN_CONFLUENCE_API_TOKEN=
# Optional with scoped tokens: the cloud id of your site (otherwise read from <site>/_edge/tenant_info).
# ATLASSIAN_CLOUD_ID=

# --- Linear (tools/linear/, docs/CONNECTING.md#linear) ---
# YOUR personal API key: Linear > Settings > Account > Security & Access > Personal API keys.
# Read permission is enough. The Keychain is read first (sbk-linear/api-key); this is the fallback.
LINEAR_API_KEY=

# --- Contacts (tools/contacts/, docs/CONNECTING.md#contacts) ---
# The Google app is the one of the other Google plugins (section "Google"): nothing new.
# Only without a Keychain (containers, Linux without a keyring): the Google Contacts login of one
# label, a refresh token or {"refresh_token": "..."}. Usually leave it empty: ct-l0-auth.py writes
# the Keychain entry sbk-gcontacts/<label>. One line per label, label in upper case.
# SBK_GCONTACTS_TOKEN_<LABEL>=
# Exports (.vcf / .csv) need no variable.

# --- Telegram (tools/telegram/) ---
# Nothing: the plugin reads the data export you make in Telegram Desktop, with no login.

# --- LLM providers (paid kernel stages, clinical parsing, WhatsApp photo descriptions) ---
# Anthropic API key: L3 extraction, clinical images, WhatsApp photos. Sends data to the provider.
ANTHROPIC_API_KEY=
# DeepSeek API key: clinical text parsing and an optional L3 provider. Sends data to the provider.
DEEPSEEK_API_KEY=
# OpenAI API key: optional L3 provider (tools/cross-source/xs_l3_common.py).
OPENAI_API_KEY=
# Google API key: optional L3 provider (tools/cross-source/xs_l3_common.py).
GOOGLE_API_KEY=
# Monitor: 1 allows the jobs of tools/monitoring/sbk-monitor.py that send your data to a model:
# new-mail triage (sender, subject, snippet of new emails), pre-meeting briefs (the meeting and its
# attendees' context), the 07:30 morning digest (mail, Slack, calendar), meeting capture (whole
# Plaud/Tactiq transcripts) and DLQ retries of scripts that call a model. Off unless you set it
# (or start the monitor with --with-model); having ANTHROPIC_API_KEY set is not enough. Without it
# the monitor still polls, downloads and alerts, and logs one line per job it skips.
# SBK_MONITOR_MODEL=

# --- Dashboard ---
# Basic auth for the web dashboard. Without them the dashboard runs with auth disabled.
SBK_AUTH_USER=
SBK_AUTH_PASS=

# --- Container mode only (uncomment SBK_CONTAINERIZED and set it to 1) ---
# Outside a container these secrets are read from the Keychain, not from here.
# Microsoft 365, IMAP/CalDAV, Zoom, GitHub, databases, HubSpot, Pipedrive, Fireflies, Fathom,
# Granola, Teams, Atlassian, Linear and Contacts read the variables in their own sections above.
# One token per label in email_accounts (sbk.config.json); the demo labels are work and personal.
# SBK_CONTAINERIZED=
SBK_GMAIL_TOKEN_WORK=
SBK_GMAIL_TOKEN_PERSONAL=
SBK_GCAL_TOKEN_WORK=
SBK_GCAL_TOKEN_PERSONAL=
SBK_GDRIVE_TOKEN_JSON=
SBK_SLACK_USER_TOKEN=
SBK_SLACK_BOT_TOKEN=
SBK_SLACK_APP_TOKEN=
# Encrypted backup (tools/infrastructure/sb-backup.py): a key you generate and keep yourself, for example
# openssl rand -base64 32. Without it the backup stops; outside a container the key is in the Keychain
# (sbk-backup/enc-key) only.
SBK_BACKUP_ENC_KEY=
