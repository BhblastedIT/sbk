<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily commitment deadlines at 09:00 (run-commitment-tracker.sh). No model call.
  Template, not active. To turn it on, run from the repo folder (fills in your paths):
    sed -e "s|__SBK_REPO__|$PWD|g" -e "s|__SBK_DATA__|${SBK_DATA_ROOT:-$HOME/.sbk-data}|g" \
        -e "s|__UV__|$(command -v uv)|g" -e "s|__UV_DIR__|$(dirname "$(command -v uv)")|g" \
        tools/monitoring/com.sbk.commitment-tracker.plist > ~/Library/LaunchAgents/com.sbk.commitment-tracker.plist
    launchctl load ~/Library/LaunchAgents/com.sbk.commitment-tracker.plist
  To turn it off: launchctl unload ~/Library/LaunchAgents/com.sbk.commitment-tracker.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sbk.commitment-tracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SBK_REPO__/tools/monitoring/run-commitment-tracker.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__SBK_DATA__/commitment-tracker-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__SBK_DATA__/commitment-tracker-stderr.log</string>
    <key>WorkingDirectory</key>
    <string>__SBK_REPO__</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
