# SBK — .gitignore
# Only the template CODE goes in the repo. Data lives in ~/.sbk-data (outside the repo).

# === SECRETS & CREDENTIALS ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials/
*credentials*.json
client_secret*.json
# code, not a secret: the Keychain/env adapter every connector imports. Kept explicit
# because a global ignore such as *secret* would otherwise leave it out of the repo.
!tools/secrets_adapter.py

# === LOCAL CONFIG & BUILD ===
sbk.config.json
.sbk-build/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/
.ruff_cache/
.mypy_cache/
node_modules/
.build/
*.log

# === LOCAL DATA (never in git) ===
/data/
/work/
# your identity files (written by tools/ai-history/ai-l3-how-you-work.py or by hand)
/sbk/identity/
# safety net: older versions wrote downloads, profiles and samples here; the code now writes
# them under the data root, but a leftover copy must never be committed
/sbk/raw/
/sbk/network/
/sbk/companies/
/scratchpad/
# your AI history, if SBK_DATA_ROOT or --input/--stats-out ever point inside the repo
/ai-history/
**/ai-history/messages.jsonl
**/ai-history/how-you-work-*
*.parquet
*.duckdb
# a PDF dossier (tools/util/gen-dossier-pdf.py writes under the data root, this is a safety net)
*.pdf

# === SYSTEM ===
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# === SAFETY NET: tokens, sessions and exports dropped into the clone by hand ===
# Nothing in SBK writes these inside the repo (logins live in the Keychain or under the data
# root, exports are imported from wherever you saved them); these lines only keep a copy you
# put here by mistake out of a commit.
token.json
google-token.json
**/token.json
*token*.json
cookies.txt
*cookies*.txt
*session*.json
plaud-wt.json
conversations.json
*.jsonl
*.vcf
*.mbox
WhatsApp Chat*
ChatStorage.sqlite*
*.sqlite
*.sqlite3
*.db
*.zip
*.tar.gz
*.tgz
*.enc
# the demo exports the tests read are fiction and stay in the repo
!tests/fixtures/**/conversations.json
!tests/fixtures/**/*.jsonl
